# AWS Configuration
aws_region = "us-east-1"

# Instance Configuration
instance_type = "t3.medium" # Recommended: t3.medium (4GB RAM)

# Project Configuration
project_name = "openclaw"
environment  = "production"

# SSH Access (recommended)
# public_key       = "ssh-ed25519 AAAA... your-email@example.com"
# ssh_allowed_cidr = "203.0.113.1/32"  # Your IP address

# Remote Dashboard Access (optional - set to "" for SSM-only access)
# dashboard_allowed_ip = "203.0.113.1/32"
