#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1
echo "=== OpenClaw bootstrap started at $(date) ==="

# ── Configuration ─────────────────────────────────────────────────────────────
EFS_ID="${efs_id}"
EFS_REGION="${aws_region}"
MOUNT_POINT="${mount_point}"
OPENCLAW_CONFIG="$${MOUNT_POINT}/.openclaw"
OPENCLAW_WORKSPACE="$${MOUNT_POINT}/workspace"

# ── Explicit environment (user-data runs with a minimal env) ─────────────────
export HOME=/root
export USER=root
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export SHELL=/bin/bash
export LANG=C.UTF-8

cw_metric() { aws cloudwatch put-metric-data --namespace OpenClaw --metric-name "$1" --value 1 --dimensions "$2" --region $${EFS_REGION} 2>/dev/null || true; }

# ── System update ─────────────────────────────────────────────────────────────
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get upgrade -y

# ── System dependencies (including efs-utils build deps) ─────────────────────
apt-get install -y git curl nfs-common stunnel4 python3-pip binutils unzip \
  build-essential cmake golang

# ── Rust (required for efs-utils build on Ubuntu 24.04) ──────────────────────
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
source /root/.cargo/env

# ── Build and install amazon-efs-utils ───────────────────────────────────────
cd /tmp
git clone --depth 1 https://github.com/aws/efs-utils.git
cd efs-utils
./build-deb.sh
apt-get install -y ./build/debbuild/amazon-efs-utils*.deb
cd / && rm -rf /tmp/efs-utils

# ── Mount EFS ────────────────────────────────────────────────────────────────
mkdir -p "$${MOUNT_POINT}"
for i in {1..5}; do
  mount -t efs -o tls "$${EFS_ID}":/ "$${MOUNT_POINT}" && break
  echo "EFS mount attempt $${i} failed, retrying in 10s..."
  sleep 10
done

if ! mountpoint -q "$${MOUNT_POINT}"; then
  echo "ERROR: EFS mount failed after retries"
  cw_metric UserDataFailure Environment=${environment}
  exit 1
fi

echo "$${EFS_ID}:/ $${MOUNT_POINT} efs _netdev,tls 0 0" >> /etc/fstab

# ── Directory setup ──────────────────────────────────────────────────────────
mkdir -p "$${OPENCLAW_CONFIG}" "$${OPENCLAW_WORKSPACE}" "$${MOUNT_POINT}/logs"

# Symlink /root/.openclaw → EFS config dir
if [ ! -L /root/.openclaw ]; then
  ln -sf "$${OPENCLAW_CONFIG}" /root/.openclaw
fi

# ── Node.js 22 via NodeSource ────────────────────────────────────────────────
curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
apt-get install -y nodejs

# ── pnpm + OpenClaw ──────────────────────────────────────────────────────────
npm install -g pnpm
pnpm setup
export PNPM_HOME="/root/.local/share/pnpm"
export PATH="$${PNPM_HOME}:$${PATH}"
pnpm add -g openclaw@latest

# ── Headless systemd fix ────────────────────────────────────────────────────
# Enables user-level systemd services (required for openclaw gateway daemon)
loginctl enable-linger root

cat >> /root/.bashrc << 'EOF'

# OpenClaw: headless systemd fix
export XDG_RUNTIME_DIR=/run/user/0
EOF

cat >> /root/.profile << 'EOF'

# OpenClaw: headless systemd fix
export XDG_RUNTIME_DIR=/run/user/0
EOF

export XDG_RUNTIME_DIR=/run/user/0

# ── SSM agent ────────────────────────────────────────────────────────────────
systemctl enable amazon-ssm-agent 2>/dev/null || true
systemctl start amazon-ssm-agent 2>/dev/null || true

# ── Auto-resume or first-time setup ─────────────────────────────────────────
if [ -f /root/.config/systemd/user/openclaw-gateway.service ]; then
  echo "Auto-resuming..."

  # Reload systemd to pick up service file from EFS after fresh boot
  systemctl --user daemon-reload

  # Start the gateway as root via user-level systemd
  if systemctl --user start openclaw-gateway 2>/dev/null; then
    sleep 10
    if systemctl --user is-active --quiet openclaw-gateway; then
      echo "Gateway resumed"
      cw_metric InstanceResumeSuccess Environment=${environment}
      RESUME_SUCCESS=true
    else
      echo "Gateway service not active after start"
      cw_metric InstanceResumeFailure "Environment=${environment},Reason=StartupFailed"
      RESUME_SUCCESS=false
    fi
  else
    echo "Failed to start openclaw-gateway service"
    cw_metric InstanceResumeFailure "Environment=${environment},Reason=StartFailed"
    RESUME_SUCCESS=false
  fi
else
  echo "First-time setup required"
  RESUME_SUCCESS=false
fi

# ── CloudWatch agent ─────────────────────────────────────────────────────────
wget -q https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
dpkg -i -E amazon-cloudwatch-agent.deb
rm -f amazon-cloudwatch-agent.deb

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << CWCFG
{"agent":{"run_as_user":"root"},"metrics":{"namespace":"OpenClaw","metrics_collected":{"mem":{"measurement":["mem_used_percent"],"metrics_collection_interval":60},"disk":{"measurement":["disk_used_percent"],"metrics_collection_interval":60,"resources":["/","$${MOUNT_POINT}"]}},"append_dimensions":{"InstanceId":"\$${aws:InstanceId}","Environment":"${environment}"}},"logs":{"logs_collected":{"files":{"collect_list":[{"file_path":"/var/log/user-data.log","log_group_name":"/${project_name}/${environment}/user-data","log_stream_name":"{instance_id}","retention_in_days":30},{"file_path":"$${MOUNT_POINT}/logs/*.log","log_group_name":"/${project_name}/${environment}/application","log_stream_name":"{instance_id}","retention_in_days":30}]}}}}
CWCFG
systemctl enable amazon-cloudwatch-agent
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s

# ── Done ─────────────────────────────────────────────────────────────────────
cw_metric UserDataSuccess Environment=${environment}
echo ""
echo "=== Bootstrap complete at $(date) ==="
echo ""
if [ "$RESUME_SUCCESS" = "true" ]; then
  echo "Gateway running: http://127.0.0.1:18789/"
else
  echo "Next steps:"
  echo "  1. Connect via SSM:"
  echo "     aws ssm start-session --target <instance-id> --region ${aws_region}"
  echo "  2. Switch to root: sudo -i"
  echo "  3. Run: openclaw onboard --install-daemon"
  echo ""
  echo "EFS mounted at: $${MOUNT_POINT}"
  echo "Config dir:     /root/.openclaw → $${OPENCLAW_CONFIG}"
  echo "Workspace:      $${OPENCLAW_WORKSPACE}"
fi
